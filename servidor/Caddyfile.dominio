# guitle.com en el servidor propio (IONOS), CON el dominio: para el día del cambio de DNS (paso "dominio").
# Caddy saca solo el certificado https de Let's Encrypt en cuanto guitle.com apunta a este servidor, y lo renueva.
# El bloque :80 de abajo sigue sirviendo por la IP (pruebas y comprobaciones).
{
	admin off
	email hola@guitle.com
}

(web) {
	@www host www.guitle.com
	redir @www https://guitle.com{uri} 301

	root * /srv/guitle/r2
	encode zstd gzip

	# Fichas de España (solo las de hoy), de los países (en cajas) y discos en cajas: las decide fichas.py
	@fichas path_regexp ^/(([a-z]{2}/)?g/[^/]+\.html|([a-z]{2}/)?(records|disques|dischi|discos)/.+\.html)$
	reverse_proxy @fichas 127.0.0.1:8081

	# "/fr" → "/fr/" (como el Worker)
	@carpeta {
		not path */
		file {
			try_files {path}/index.html
		}
	}
	redir @carpeta {path}/ 301

	header /img/p/* Cache-Control "public, max-age=2592000, immutable"
	header /data/* Cache-Control "public, max-age=60"
	header ?Cache-Control "public, max-age=600"
	header X-Content-Type-Options nosniff

	# Parte de salud del servidor (salud.sh, cada 5 minutos), fuera de la copia de R2
	handle /salud-servidor.json {
		root * /srv/guitle/salud
		header Cache-Control "no-store"
		file_server
	}

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@nf expression {err.status_code} == 404
		reverse_proxy @nf 127.0.0.1:8081
	}
}

guitle.com, www.guitle.com {
	import web
}

:80 {
	import web
}
